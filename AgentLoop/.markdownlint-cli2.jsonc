{
  // 全仓 Markdown；规则同步自 Ascend/docs 的 .doctools。
  "globs": ["**/*.md"],

  // 排除生成物/工作产物：install 脚本生成的 junction 投影、流水线产物、依赖。
  "ignores": [
    "node_modules/**",
    "**/.pytest_cache/**",
    ".dsh/**",
    "plugins/*/skills/**",
    "outputs/**",
    "tmp/**",
    ".doc-work/**",
    ".workspace-local/**",
    ".tmp/**",
    ".pylibs/**"
  ],

  "config": {
    // https://gitcode.com/Ascend/docs/tree/master/.doctools
    // 上游提交：54bb84c2d8e331b1b31c86ee0caa4353a8e618b7
    "extends": ".doctools/markdownlint.config.json"
  }
}
