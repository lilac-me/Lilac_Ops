#!/bin/bash
# ============================================================================
# 训练脚本模板 —— 昇腾 NPU
#
# 用法：cp 到 <model>/test/ 下改名，如 train_full_8p.sh / train_performance_8p.sh
#   bash test/train_full_8p.sh --num_npus=8 --dataset_path=xxx --model_path=xxx
#
# 结构参照 Lingbot-vla/test/train_16p_perf.sh + Pi-0/test/train_8p.sh
#
# ⚠️ 精度跑与性能跑必须是两次独立运行，不要合并：
#     - 精度跑：开确定性开关，跑满 max_steps，报 Final Loss
#     - 性能跑：关确定性开关，跑 perf_steps 步，报 FPS
# ============================================================================

set -uo pipefail

# ---------------------------------------------------------------------------
# 环境
# ---------------------------------------------------------------------------
CUR_DIR=$(cd "$(dirname "$0")" && pwd)
if [ -f "${CUR_DIR}/env_npu.sh" ]; then
    source "${CUR_DIR}/env_npu.sh"
fi

# ⚠️ 精度跑请取消下面两行注释；性能跑保持注释（确定性有开销）
# export HCCL_DETERMINISTIC=true
# export CLOSE_MATMUL_K_SHIFT=1

# 注：ASCEND_RT_VISIBLE_DEVICES 不在这里写死 —— 见下方「设备可见性」段，
#     未显式指定时按 --num_npus 推导，避免 8 卡机模板落到 4 卡场景时可见设备对不上。

# ---------------------------------------------------------------------------
# 默认参数
# ---------------------------------------------------------------------------
Network="MyModel"
ROOT_DIR=$(pwd)

num_npus=8
micro_batch_size=8
global_batch_size=64
max_steps=1000
perf_steps=300          # 性能统计取最后 N 步的平均
seed=1234

dataset_path=""
model_path=""
output_dir=${ROOT_DIR}/output

nnodes=${NNODES:-1}
node_rank=${NODE_RANK:-0}
master_addr=${MASTER_ADDR:-127.0.0.1}
master_port=${MASTER_PORT:-29500}

# ---------------------------------------------------------------------------
# 解析 --key=value
# ---------------------------------------------------------------------------
for para in $*; do
    if [[ $para == --num_npus* ]]; then
        num_npus=$(echo ${para#*=})
    elif [[ $para == --micro_batch_size* ]]; then
        micro_batch_size=$(echo ${para#*=})
    elif [[ $para == --global_batch_size* ]]; then
        global_batch_size=$(echo ${para#*=})
    elif [[ $para == --max_steps* ]]; then
        max_steps=$(echo ${para#*=})
    elif [[ $para == --perf_steps* ]]; then
        perf_steps=$(echo ${para#*=})
    elif [[ $para == --dataset_path* ]]; then
        dataset_path=$(echo ${para#*=})
    elif [[ $para == --model_path* ]]; then
        model_path=$(echo ${para#*=})
    elif [[ $para == --output_dir* ]]; then
        output_dir=$(echo ${para#*=})
    elif [[ $para == --seed* ]]; then
        seed=$(echo ${para#*=})
    elif [[ $para == --nnodes* ]]; then
        nnodes=$(echo ${para#*=})
    elif [[ $para == --node_rank* ]]; then
        node_rank=$(echo ${para#*=})
    elif [[ $para == --master_addr* ]]; then
        master_addr=$(echo ${para#*=})
    elif [[ $para == --master_port* ]]; then
        master_port=$(echo ${para#*=})
    fi
done

# ---------------------------------------------------------------------------
# 参数校验（提前失败，别等 torchrun 起来才报错）
# ---------------------------------------------------------------------------
if [[ "$dataset_path" == "" ]]; then
    echo "[Error] para \"dataset_path\" must be configured."; exit 1
fi
if [ ! -d "$dataset_path" ]; then
    echo "[Error] dataset path \"$dataset_path\" does not exist."; exit 1
fi
if [[ "$model_path" == "" ]]; then
    echo "[Error] para \"model_path\" must be configured."; exit 1
fi
if [ ! -d "$model_path" ]; then
    echo "[Error] model path \"$model_path\" does not exist."; exit 1
fi

# 口径自检：FPS = global_batch_size / step_time，global 填错会让 FPS 静默偏掉一个卡数倍。
# 有梯度累积时 global ≠ micro × 卡数属正常，所以只警告、不中止。
expected_gbs=$((micro_batch_size * num_npus))
if [ "${global_batch_size}" != "${expected_gbs}" ]; then
    echo "[Warn] global_batch_size=${global_batch_size} != micro_batch_size(${micro_batch_size}) × num_npus(${num_npus}) = ${expected_gbs}"
    echo "       有梯度累积则属正常；否则 FPS 会算错，请核对后再跑"
fi

# perf_steps 是「取日志末 N 步算均值」的 N，为 0/空会让提取段以
# 「未找到 StepTime 记录」这种误导性信息退出，所以在这里先拦一道。
if [ -z "${perf_steps}" ] || [ "${perf_steps}" -le 0 ] 2>/dev/null; then
    echo "[Error] para \"perf_steps\" must be a positive integer (got \"${perf_steps}\")."; exit 1
fi
if [ "${perf_steps}" -gt "${max_steps}" ] 2>/dev/null; then
    echo "[Warn] perf_steps(${perf_steps}) > max_steps(${max_steps})：实际只有 max_steps 步参与统计"
fi

# ---------------------------------------------------------------------------
# 设备可见性：未显式指定时按 num_npus 推导 0..(N-1)
# 多机场景每台机器都取本机 0..N-1；已由环境/调度器给出则尊重环境值。
# ---------------------------------------------------------------------------
if [ -z "${ASCEND_RT_VISIBLE_DEVICES:-}" ]; then
    _visible_devices=""
    for ((_i = 0; _i < num_npus; _i++)); do
        _visible_devices="${_visible_devices:+${_visible_devices},}${_i}"
    done
    export ASCEND_RT_VISIBLE_DEVICES="${_visible_devices}"
fi

# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
WORLD_SIZE=$((num_npus * nnodes))
CaseName=${Network}_bs${global_batch_size}_${WORLD_SIZE}p
LOG_DIR=${CUR_DIR}/output/${CaseName}
mkdir -p ${LOG_DIR} ${output_dir}
LOG_FILE=${LOG_DIR}/train.log

echo "=========================================="
echo " Network        : ${Network}"
echo " NPUs           : ${num_npus} x ${nnodes} nodes = ${WORLD_SIZE}"
echo " global batch   : ${global_batch_size}"
echo " max steps      : ${max_steps}"
echo " dataset        : ${dataset_path}"
echo " model          : ${model_path}"
echo " log            : ${LOG_FILE}"
echo "=========================================="

start_time=$(date +%s)

# ---------------------------------------------------------------------------
# 启动
# ---------------------------------------------------------------------------
# 注：单卡也建议走 torchrun —— 顺带保证 LOCAL_RANK 有定义
torchrun \
    --nnodes=${nnodes} \
    --nproc-per-node=${num_npus} \
    --node-rank=${node_rank} \
    --master-addr=${master_addr} \
    --master-port=${master_port} \
    train.py \
        --dataset_path ${dataset_path} \
        --model_path ${model_path} \
        --output_dir ${output_dir} \
        --micro_batch_size ${micro_batch_size} \
        --global_batch_size ${global_batch_size} \
        --max_steps ${max_steps} \
        --seed ${seed} \
    2>&1 | tee ${LOG_FILE}

end_time=$(date +%s)
e2e_time=$((end_time - start_time))

# ---------------------------------------------------------------------------
# 结果提取
# ---------------------------------------------------------------------------
if [ ! -f "${LOG_FILE}" ]; then
    echo "Log Error: 日志文件 ${LOG_FILE} 未生成"; exit 1
fi

# --- FPS：从 StepTime 计算（需要训练脚本按此格式打印）---
# 期望日志形如： Step 100/1000, Loss 0.1234, StepTime 0.523s
step_time=$(grep -aE "Step [0-9]+/[0-9]+, .*StepTime " ${LOG_FILE} \
    | tail -n ${perf_steps} \
    | sed -nE "s/.*StepTime ([0-9.eE+-]+)s.*/\1/p" \
    | awk '{sum += $1; count += 1} END {if (count > 0) printf "%.4f", sum / count}')

if [ -z "$step_time" ]; then
    echo "Log Error: 未找到 StepTime 记录"
    echo "  → 训练循环需按下面这一行的格式打印 StepTime，否则本脚本取不到 FPS："
    echo "       print(f\"Step {step}/{max_steps}, Loss {loss:.4f}, StepTime {step_time:.3f}s\")"
    echo "     若模型本来就有别的计时口径，改上面的 grep 去适配它。"
    exit 1
fi

FPS=$(awk 'BEGIN{printf "%.2f\n", '${global_batch_size}'/'${step_time}'}')
# ModelZoo 的 TrainingTime：语料里的标准写法是「1000 步的耗时」——
#     TrainingTime = batch_size * 1000 / FPS
# 本模板按 max_steps × step_time 给，两者在 max_steps=1000（默认）时**代数上完全等价**；
# 若实跑 max_steps ≠ 1000 而评审要求固定 1000 步口径，把下面的 max_steps 换成 1000。
# 与 E2ETrainingTime 区分：那个是脚本全程墙钟（含启动 / 数据准备 / 收尾）。
TrainingTime=$(awk 'BEGIN{printf "%.1f\n", '${max_steps}' * '${step_time}'}')

# --- Loss ---
FinalLoss=$(grep -aoE "Loss [0-9.eE+-]+" ${LOG_FILE} | tail -n 1 | awk '{print $2}')
MeanLoss=$(grep -aoE "Loss [0-9.eE+-]+" ${LOG_FILE} \
    | awk '{sum += $2; cnt += 1} END {if (cnt > 0) printf "%.4f", sum / cnt}')

# ---------------------------------------------------------------------------
# 汇总（ModelZoo 标准字段）
# ---------------------------------------------------------------------------
RESULT_FILE=${LOG_DIR}/${CaseName}_result.log
{
    # ModelZoo 收尾字段 —— 评审工具按名抓取，这四个名字不要改
    echo "Network       = ${Network}"
    echo "DeviceType    = $(uname -m)"
    echo "CaseName      = ${CaseName}"
    echo "BatchSize     = ${global_batch_size}"
    echo "WorldSize     = ${WORLD_SIZE}"
    echo "MaxSteps      = ${max_steps}"
    echo "ActualFPS     = ${FPS}"
    echo "TrainingTime  = ${TrainingTime}"
    echo "ActualLoss    = ${FinalLoss}"
    echo "E2ETrainingTime = ${e2e_time}"
    # 以下 ModelZoo 不解析，是给人看的附加信息
    echo "StepTime      = ${step_time}"
    echo "MeanLoss      = ${MeanLoss}"
    # 序列长度主导的模型（视频 / 扩散 / VLM）：样本间序列长度差异大时 FPS 不可比，
    # 另算真实吞吐更有意义（tokens/s = tokens_per_step / StepTime）；ModelZoo 字段照打。
    # echo "TokensPerSec  = ${TOKENS_PER_SEC}"
} | tee ${RESULT_FILE}

echo ""
echo "结果已写入: ${RESULT_FILE}"
