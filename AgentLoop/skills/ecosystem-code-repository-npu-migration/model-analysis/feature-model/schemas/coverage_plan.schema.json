{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "coverage_mode", "capability_checks", "representative_groups", "scope_decisions", "rationale"],
  "properties": {
    "schema_version": {"const": "npu-coverage-plan-v2"},
    "coverage_mode": {"enum": ["representative", "adaptive", "exhaustive"]},
    "capability_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "selected_entry_ids", "rationale"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "selected_entry_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "representative_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "feature_ids", "member_entry_ids", "representative_entry_ids", "deferred_entry_ids", "selection_reason", "verification_goal", "risk_level"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "feature_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "member_entry_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "representative_entry_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "deferred_entry_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "selection_reason": {"type": "string", "minLength": 1},
          "verification_goal": {"type": "string", "minLength": 1},
          "risk_level": {"enum": ["low", "medium", "high"]}
        },
        "additionalProperties": false
      }
    },
    "scope_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry_id", "disposition", "reason"],
        "properties": {
          "entry_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["OUT_OF_SCOPE", "MANUAL", "BLOCKED"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "rationale": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
