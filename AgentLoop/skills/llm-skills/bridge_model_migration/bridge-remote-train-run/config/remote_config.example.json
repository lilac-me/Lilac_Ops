{
  "schema_version": 2,
  "connection": {
    "host": "your-ssh-host",
    "user": "root",
    "port": 22,
    "connect_timeout_seconds": 10
  },
  "repositories": [
    {
      "local_path": "/path/to/local/Megatron-Bridge",
      "remote_path": "/home/<user>/code/bridge_skill_test/Megatron-Bridge"
    },
    {
      "local_path": "/path/to/local/Megatron-LM",
      "remote_path": "/home/<user>/code/bridge_skill_test/Megatron-LM"
    },
    {
      "local_path": "/path/to/local/MindSpeed-Bridge",
      "remote_path": "/home/<user>/code/bridge_skill_test/MindSpeed-Bridge"
    },
    {
      "local_path": "/path/to/local/MegatronAdaptor",
      "remote_path": "/home/<user>/code/bridge_skill_test/MegatronAdaptor"
    },
    {
      "local_path": "/path/to/local/TransformerEngineNPU",
      "remote_path": "/home/<user>/code/bridge_skill_test/TransformerEngineNPU"
    },
    {
      "local_path": "/path/to/local/MindSpeed-Ops",
      "remote_path": "/home/<user>/code/bridge_skill_test/MindSpeed-Ops"
    }
  ],
  "execution": {
    "script": "examples/models/<model_family>/<model>_<model_size>_<train_mode>.sh",
    "script_repo": "/path/to/local/MindSpeed-Bridge",
    "runner": "docker",
    "docker": {
      "container": "your-container-name",
      "mounts": [
        {"host": "/home", "container": "/home"}
      ]
    },
    "cann_env_scripts": [
      "/usr/local/Ascend/ascend-toolkit/set_env.sh"
    ],
    "timeout_seconds": 7200,
    "capture_npu_smi": true
  },
  "sync": {
    "delete": true,
    "exclude": [],
    "preserve_owner_group": false
  },
  "output": {
    "local_path": "output"
  }
}
