{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindSpeed-LLM / MindSpeed-Bridge Remote Validation Config",
  "type": "object",
  "required": ["connection", "repositories"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "connection": {
      "type": "object",
      "required": ["host", "user"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "user": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "connect_timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["local_path", "remote_path"],
        "properties": {
          "local_path": {"type": "string", "minLength": 1},
          "remote_path": {"type": "string", "pattern": "^/"}
        },
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "required": ["script"],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "训练命令参数：相对 script_repo 工作目录的相对路径（可含 ..，例如 ../MindSpeed-Bridge/xxx.sh）；多目录同步不改变其执行路径"
        },
        "script_args": {"type": "array", "items": {"type": "string"}},
        "script_repo": {
          "type": "string",
          "minLength": 1,
          "description": "训练脚本所属仓库（local_path 或 remote_path，须匹配 repositories 某项）；默认第一个仓库"
        },
        "runner": {"type": "string", "enum": ["conda", "docker"], "default": "conda"},
        "conda_env": {"type": "string", "minLength": 1, "description": "conda runner 下的环境名"},
        "cann_env_scripts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^/"},
          "description": "CANN 环境脚本：conda 模式为宿主机路径，docker 模式为容器内路径"
        },
        "docker": {
          "type": "object",
          "required": ["container"],
          "properties": {
            "container": {"type": "string", "minLength": 1},
            "mounts": {
              "type": "array",
              "description": "可选。声明期望的 host→container 映射（支持父级映射，如 /home→/home）；preflight 按路径前缀与 docker inspect 的实际挂载核对，并据此推导训练仓库在容器内的执行目录；不配置时默认容器路径与远端路径相同",
              "items": {
                "type": "object",
                "required": ["host", "container"],
                "properties": {
                  "host": {"type": "string", "pattern": "^/"},
                  "container": {"type": "string", "pattern": "^/"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "capture_npu_smi": {
          "type": "boolean",
          "description": "兼容旧配置；run 模式始终执行并记录强制 NPU 空闲检查，此字段不能关闭门禁"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"properties": {"runner": {"const": "conda"}}},
              {"not": {"required": ["runner"]}}
            ]
          },
          "then": {"required": ["conda_env", "cann_env_scripts"]}
        },
        {
          "if": {"properties": {"runner": {"const": "docker"}}},
          "then": {"required": ["docker", "cann_env_scripts"]}
        }
      ]
    },
    "sync": {
      "type": "object",
      "properties": {
        "delete": {
          "type": "boolean",
          "default": false,
          "description": "true 时 rsync 追加 --delete，远端删除本地不存在的文件（保持两端一致；适合首次同步/清理残留）。开启时脚本要求每个 repository.remote_path 至少三级目录；命令行 --sync-delete 可覆盖此配置"
        },
        "exclude": {"type": "array", "items": {"type": "string"}},
        "preserve_owner_group": {
          "type": "boolean",
          "default": false,
          "description": "true 时 rsync 保留源端属主/属组（-a 内含 -o -g）；默认 false 追加 --no-o --no-g 不保留"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "local_path": {
          "type": "string",
          "minLength": 1,
          "description": "本地输出根目录；相对路径以 Skill 仓库根目录解析"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
