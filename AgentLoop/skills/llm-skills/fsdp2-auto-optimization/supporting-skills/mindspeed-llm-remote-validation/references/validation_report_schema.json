{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindSpeed-LLM Remote Validation Report",
  "type": "object",
  "required": ["schema_version", "workflow", "mode", "run_id", "passed", "stage", "errors", "plan", "artifacts"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "workflow": {"type": "string", "const": "mindspeed-llm-remote-validation"},
    "mode": {"type": "string", "enum": ["plan", "preflight", "run"]},
    "run_id": {"type": "string"},
    "passed": {"type": "boolean"},
    "stage": {"type": "string"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "plan": {"type": "object"},
    "sync_result": {"type": "object"},
    "preflight_result": {"type": "object"},
    "resource_snapshot": {"type": ["object", "null"]},
    "training_result": {"type": "object"},
    "artifacts": {"type": "object"}
  }
}
