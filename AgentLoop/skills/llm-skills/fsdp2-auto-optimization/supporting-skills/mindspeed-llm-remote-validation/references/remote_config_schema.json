{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindSpeed-LLM Remote Validation Config",
  "type": "object",
  "required": ["connection", "repository", "execution"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "connection": {
      "type": "object",
      "required": ["host", "user"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "user": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "connect_timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["local_path", "remote_path"],
      "properties": {
        "local_path": {"type": "string", "minLength": 1},
        "remote_path": {"type": "string", "pattern": "^/"}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["script", "conda_env", "cann_env_scripts"],
      "properties": {
        "script": {"type": "string", "minLength": 1},
        "script_args": {"type": "array", "items": {"type": "string"}},
        "conda_env": {"type": "string", "minLength": 1},
        "cann_env_scripts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^/"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "capture_npu_smi": {
          "type": "boolean",
          "description": "兼容旧配置；run 模式始终执行并记录强制 NPU 空闲检查，此字段不能关闭门禁。"
        }
      },
      "additionalProperties": false
    },
    "sync": {
      "type": "object",
      "properties": {
        "delete": {"type": "boolean"},
        "exclude": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "local_path": {
          "type": "string",
          "minLength": 1,
          "description": "本地输出根目录；相对路径以当前 Skill 集合根目录解析，run 产物使用 remote-validation-0001 等递增子目录。"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
