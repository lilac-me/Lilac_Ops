{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindSpeed-LLM Loss Accuracy Validation Report",
  "type": "object",
  "required": [
    "schema_version",
    "workflow",
    "status",
    "gate_passed",
    "threshold",
    "baseline",
    "candidate",
    "comparison",
    "errors",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "workflow": {
      "type": "string",
      "const": "mindspeed-llm-loss-accuracy-validation"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed", "blocked"]
    },
    "gate_passed": {"type": "boolean"},
    "threshold": {
      "type": "object",
      "required": ["metric", "max_relative_error_percent"],
      "properties": {
        "metric": {
          "type": "string",
          "const": "loss_mean_relative_absolute_error"
        },
        "max_relative_error_percent": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "baseline": {
      "$ref": "#/$defs/run"
    },
    "candidate": {
      "$ref": "#/$defs/run"
    },
    "comparison": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/comparison"}
      ]
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "artifacts": {
      "type": "object",
      "required": ["report"],
      "properties": {
        "report": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["run_id", "run_dir"],
      "properties": {
        "run_id": {"type": "string"},
        "run_dir": {"type": "string"},
        "validation_report": {"type": "string"},
        "training_log": {"type": "string"},
        "training_script": {"type": "string"}
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "compared_points",
        "compared_iteration_start",
        "compared_iteration_end",
        "baseline_total_training_steps",
        "candidate_total_training_steps",
        "mean_relative_absolute_error",
        "mean_relative_absolute_error_percent",
        "max_relative_absolute_error",
        "max_relative_absolute_error_percent",
        "per_iteration"
      ],
      "properties": {
        "compared_points": {"type": "integer", "minimum": 1},
        "compared_iteration_start": {"type": "integer", "const": 1},
        "compared_iteration_end": {"type": "integer", "minimum": 1},
        "baseline_total_training_steps": {"type": "integer", "minimum": 1},
        "candidate_total_training_steps": {"type": "integer", "minimum": 1},
        "mean_relative_absolute_error": {"type": "number", "minimum": 0},
        "mean_relative_absolute_error_percent": {"type": "number", "minimum": 0},
        "max_relative_absolute_error": {"type": "number", "minimum": 0},
        "max_relative_absolute_error_percent": {"type": "number", "minimum": 0},
        "per_iteration": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "iteration",
              "baseline_loss",
              "candidate_loss",
              "relative_absolute_error",
              "relative_absolute_error_percent"
            ],
            "properties": {
              "iteration": {"type": "integer", "minimum": 1},
              "baseline_loss": {"type": "number"},
              "candidate_loss": {"type": "number"},
              "relative_absolute_error": {"type": "number", "minimum": 0},
              "relative_absolute_error_percent": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
