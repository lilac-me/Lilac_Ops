{
  "schema_version": 1,
  "connection": {
    "host": "your.validation.host",
    "user": "your_remote_user",
    "port": 22,
    "connect_timeout_seconds": 10
  },
  "repository": {
    "local_path": "/absolute/path/to/MindSpeed-LLM-worktree",
    "remote_path": "/home/your_remote_user/validation/MindSpeed-LLM"
  },
  "execution": {
    "task_type": "training",
    "script": "examples/fsdp2/qwen3_moe/pretrain_qwen3_30b_4k_fsdp2_A2.sh",
    "script_args": [],
    "conda_env": "your_conda_env",
    "cann_env_scripts": [
      "/remote/path/to/ascend-toolkit/set_env.sh"
    ],
    "timeout_seconds": 7200,
    "capture_npu_smi": true
  },
  "sync": {
    "delete": false,
    "exclude": []
  },
  "output": {
    "local_path": "output"
  }
}
