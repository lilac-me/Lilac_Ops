{
  "schema_version": 1,
  "connection": {
    "host": "your.validation.host",
    "user": "your_remote_user",
    "port": 22,
    "connect_timeout_seconds": 10
  },
  "repository": {
    "local_path": "/absolute/path/to/MindSpeed-LLM-worktree",
    "remote_path": "/home/your_remote_user/validation/MindSpeed-LLM"
  },
  "execution": {
    "task_type": "precision-alignment",
    "script": "examples/fsdp2/qwen3_moe/precision_alignment/run_complete_alignment.sh",
    "script_args": [],
    "environment": {
      "MODEL_DIR": "/remote/path/to/complete/Qwen3-30B-A3B",
      "REFERENCE_PYTHON": "/remote/path/to/reference-venv/bin/python",
      "CANDIDATE_PYTHON": "/remote/path/to/candidate-venv/bin/python",
      "TRANSFORMERS_SOURCE": "/remote/path/to/transformers/src",
      "WORLD_SIZE": "8"
    },
    "required_remote_paths": [
      {
        "path": "/remote/path/to/complete/Qwen3-30B-A3B",
        "kind": "directory"
      },
      {
        "path": "/remote/path/to/reference-venv/bin/python",
        "kind": "executable"
      },
      {
        "path": "/remote/path/to/candidate-venv/bin/python",
        "kind": "executable"
      },
      {
        "path": "/remote/path/to/transformers/src",
        "kind": "directory"
      },
      {
        "path": "/remote/path/to/transformers/src/transformers/models/qwen3_moe/modeling_qwen3_moe.py",
        "kind": "file"
      },
      {
        "path": "{remote_repo}/.validation-runtime/precision-alignment/run_alignment.py",
        "kind": "file"
      }
    ],
    "conda_env": "请填写用于加载 CANN 和 Candidate 依赖的 Conda 环境",
    "cann_env_scripts": [
      "/remote/path/to/ascend-toolkit/set_env.sh"
    ],
    "timeout_seconds": 14400,
    "capture_npu_smi": true
  },
  "sync": {
    "delete": false,
    "exclude": [
      "output/",
      "*.local.json"
    ],
    "runtime_bundles": [
      {
        "local_path": "../../precision-alignment/scripts",
        "remote_subdir": ".validation-runtime/precision-alignment",
        "delete": true,
        "include": [
          "alignment_utils.py",
          "compare_logits.py",
          "dump_mindspeed_fsdp2_logits.py",
          "dump_transformers_logits.py",
          "make_fixed_input.py",
          "prepare_checkpoint_view.py",
          "run_alignment.py",
          "write_alignment_report.py"
        ],
        "exclude": [
          "__pycache__",
          "*.pyc"
        ]
      }
    ]
  },
  "artifacts": {
    "remote_path": "{remote_repo}/.validation-artifacts/{run_id}",
    "include": [
      "*.json",
      "*.md",
      "*.log"
    ],
    "exclude": [
      "*.pt"
    ],
    "pull_on_failure": true
  },
  "output": {
    "local_path": "output"
  }
}
