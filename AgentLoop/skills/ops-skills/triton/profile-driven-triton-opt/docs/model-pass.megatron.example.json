{
  "training": {
    "backend": "megatron",
    "integration": "native",
    "model_root": "/path/to/model",
    "launch_command": [
      "bash",
      "train.sh"
    ],
    "max_steps": 20,
    "benchmark_warmup_steps": 10,
    "metric_rank": 0,
    "metrics": "megatron_log"
  },
  "profiling": {
    "skip_first": 10,
    "warmup": 1,
    "active": 3,
    "ranks": [
      0
    ]
  },
  "workload": {
    "model": "replace-with-model-and-config",
    "checkpoint": "/path/to/immutable-checkpoint",
    "data": "/path/to/fixed-data-and-order",
    "seed": 42,
    "precision": "bf16",
    "parallelism": {
      "tp": 1,
      "pp": 1,
      "dp": 8
    },
    "batch_size": 8,
    "sequence_length": 4096
  },
  "source_map": {
    "causal_conv1d_fwd_kernel": {
      "source": "fsdp/ops/gdn/triton/convolution.py",
      "mode": "B"
    }
  },
  "analyzer": {
    "bottleneck_threshold": 0.03,
    "max_shapes": 5
  },
  "operator_config": {
    "metric_mode": "speedup",
    "target_speedup": 2,
    "max_opt_iterations": 20
  },
  "min_steps": 5,
  "profile_subdir": "."
}
