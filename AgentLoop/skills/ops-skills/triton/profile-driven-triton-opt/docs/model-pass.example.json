{
  "model_root": "/path/to/MindSpeed-model",
  "profile_command": ["bash", "scripts/profile_for_agentloop.sh"],
  "benchmark_command": [
    "python3", "{agentloop_root}/plugins/ops/engine/training_benchmark.py",
    "--warmup-steps", "5", "--tokens-per-step", "32768",
    "--", "bash", "scripts/train_without_profile.sh"
  ],
  "profile_subdir": ".",
  "workload": {
    "model": "replace-with-model-and-config",
    "checkpoint": "/path/to/immutable-checkpoint",
    "data": "/path/to/fixed-data-and-order",
    "seed": 42,
    "precision": "bf16",
    "parallelism": {"tp": 1, "pp": 1, "dp": 8},
    "batch_size": 8,
    "sequence_length": 4096
  },
  "source_map": {
    "causal_conv1d_fwd_kernel": {"source": "fsdp/ops/gdn/triton/convolution.py", "mode": "B"}
  },
  "analyzer": {"bottleneck_threshold": 0.03, "max_shapes": 5},
  "operator_config": {"metric_mode": "speedup", "target_speedup": 2.0, "max_opt_iterations": 20},
  "timeout_seconds": 7200,
  "min_steps": 5,
  "loss_atol": 0.00001,
  "loss_rtol": 0.001,
  "max_step_regression_pct": 0
}
