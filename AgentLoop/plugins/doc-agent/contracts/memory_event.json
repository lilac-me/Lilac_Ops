{
  "title": "MemoryEvent",
  "description": "账本事件：阶段转移、门控判定、issue 生命周期与检查点",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "type"],
  "properties": {
    "ts": { "type": "string" },
    "type": {
      "enum": ["phase_enter", "gate_pass", "gate_fail", "issue_found", "issue_fixed", "issue_verified", "checkpoint"]
    },
    "phase": { "type": "string" },
    "issue_id": { "type": "string" },
    "payload": { "type": "object" }
  }
}
