{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindspeed-agent.local/batch-invariance-validation/run_config.schema.json",
  "title": "Batch Invariance Run Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "model", "chip", "device_topology", "tp_plan", "tp_confirmation", "sampling", "service", "scheduling", "mutation_policy", "tp_change_history"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "architecture"],
      "properties": {"path": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "revision": {"type": ["string", "null"]}}
    },
    "chip": {"type": "string", "enum": ["A2", "A3", "A5"]},
    "device_topology": {
      "type": "object", "additionalProperties": false,
      "required": ["visible_devices", "device_count", "parallelism"],
      "properties": {
        "visible_devices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": ["integer", "string"]}},
        "device_count": {"type": "integer", "minimum": 1},
        "parallelism": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}, "required": ["tp"]}
      }
    },
    "tp_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["phase1", "phase2_long_output", "phase2_long_input", "phase2_matrix", "phase3"],
      "properties": {
        "phase1": {"type": "integer", "minimum": 1},
        "phase2_long_output": {"type": "integer", "minimum": 1},
        "phase2_long_input": {"type": "integer", "minimum": 1},
        "phase2_matrix": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "phase3": {"type": "integer", "minimum": 1}
      }
    },
    "tp_confirmation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source", "confirmed_utc", "user_response"],
      "properties": {
        "status": {"const": "confirmed"},
        "source": {"enum": ["user_explicit", "default_confirmed", "auto_planned"]},
        "confirmed_utc": {"type": "string", "format": "date-time"},
        "user_response": {"type": "string", "minLength": 1}
      }
    },
    "sampling": {
      "type": "object", "additionalProperties": false,
      "required": ["phase2_temperature", "phase3_temperature", "seed"],
      "properties": {
        "phase2_temperature": {"type": "number", "minimum": 0},
        "phase3_temperature": {"const": 0},
        "seed": {"type": "integer"}
      }
    },
    "service": {
      "type": "object", "additionalProperties": true,
      "required": ["generation_config", "enable_prefix_caching", "enable_chunked_prefill"],
      "properties": {
        "generation_config": {"const": "vllm"},
        "enable_prefix_caching": {"const": false},
        "enable_chunked_prefill": {"const": false}
      }
    },
    "scheduling": {
      "type": "object", "additionalProperties": true,
      "required": ["max_model_len", "max_num_batched_tokens", "max_num_seqs", "gpu_memory_utilization", "async_scheduling"],
      "properties": {
        "max_model_len": {"type": "integer", "minimum": 1},
        "max_num_batched_tokens": {"type": "integer", "minimum": 1},
        "max_num_seqs": {"type": "integer", "minimum": 1},
        "gpu_memory_utilization": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "async_scheduling": {"type": "boolean"}
      }
    },
    "mutation_policy": {"enum": ["validate_only", "repair_if_unambiguous"], "default": "validate_only"},
    "tp_planning": {
      "type": "object", "additionalProperties": true,
      "required": ["mode", "visible_device_count", "candidate_tps", "compatible_tps", "selected_plan"],
      "properties": {
        "mode": {"const": "auto_from_visible_devices"},
        "visible_device_count": {"type": "integer", "minimum": 1},
        "candidate_tps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "compatible_tps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "selected_plan": {"type": "object"}
      }
    },
    "execution_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["tp_planning", "environment_repair", "operator_repair", "blocked_recovery", "max_issue_recovery_rounds", "max_stage_recovery_rounds", "max_run_recovery_rounds"],
      "properties": {
        "tp_planning": {"const": "auto_from_visible_devices"},
        "environment_repair": {"const": "auto"},
        "operator_repair": {"const": "auto_minimal_change"},
        "blocked_recovery": {"const": "evidence_driven"},
        "max_issue_recovery_rounds": {"const": 5},
        "max_stage_recovery_rounds": {"const": 10},
        "max_run_recovery_rounds": {"const": 20}
      }
    },
    "tp_change_history": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["changed_utc", "reason", "affected_stages", "previous_plan", "new_plan", "confirmation"],
        "properties": {
          "changed_utc": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1},
          "affected_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["environment", "phase1", "phase2", "phase3"]}},
          "previous_plan": {"$ref": "#/$defs/tpPlan"},
          "new_plan": {"$ref": "#/$defs/tpPlan"},
          "confirmation": {"$ref": "#/$defs/tpConfirmation"}
        }
      }
    }
  },
  "$defs": {
    "tpPlan": {"type": "object", "additionalProperties": false, "required": ["phase1", "phase2_long_output", "phase2_long_input", "phase2_matrix", "phase3"], "properties": {"phase1": {"type": "integer", "minimum": 1}, "phase2_long_output": {"type": "integer", "minimum": 1}, "phase2_long_input": {"type": "integer", "minimum": 1}, "phase2_matrix": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}, "phase3": {"type": "integer", "minimum": 1}}},
    "tpConfirmation": {"type": "object", "additionalProperties": false, "required": ["status", "source", "confirmed_utc", "user_response"], "properties": {"status": {"const": "confirmed"}, "source": {"enum": ["user_explicit", "default_confirmed", "auto_planned"]}, "confirmed_utc": {"type": "string", "format": "date-time"}, "user_response": {"type": "string", "minLength": 1}}}
  }
}
