{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindspeed-agent.local/batch-invariance-validation/stage_result.schema.json",
  "title": "Batch Invariance Stage Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "stage", "state", "outcome", "reason_code", "resume_state", "attempt", "config_summary", "artifacts", "handoff"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["environment", "phase1", "phase2", "phase3"]},
    "state": {"enum": ["environment_admission", "blocked_environment", "phase1_profiling", "phase1_triage", "phase1_critical_path_review", "phase1_operator_10k", "phase1_replacement", "phase1_reprofile", "blocked_phase1", "phase2_long_output", "phase2_long_input", "phase2_matrix", "phase2_failure_diagnosis", "blocked_phase2", "phase3_math500", "blocked_phase3"]},
    "outcome": {"enum": ["PASS", "BLOCKED", "FAIL", "REVIEW_REQUIRED", "INVALID", "SKIPPED", "PARTIAL", "UNVERIFIED", "ERROR", "RETRY"]},
    "reason_code": {
      "type": ["string", "null"],
      "enum": [null, "BLOCKED_CHIP_DETECTION", "BLOCKED_OPERATOR_INSTALLATION", "BLOCKED_A5_OPERATOR_PACKAGE_INSTALL_UNSUPPORTED", "BLOCKED_RECOVERY_EXHAUSTED", "BLOCKED_DUMP_ALIGNMENT", "BLOCKED_DUMP_ALIGNMENT_INFRA", "BLOCKED_DUMP_ERROR", "BLOCKED_EVICTION_UNSUPPORTED", "BLOCKED_EXACT_PROMPT_COUNT", "BLOCKED_EXACT_PROMPT_LENGTH", "BLOCKED_FAILURE_MANIFEST_INCOMPLETE", "BLOCKED_MISSING_OP_STATISTIC", "BLOCKED_MSPROBE_DOCUMENTATION_INCOMPLETE", "BLOCKED_MSPROBE_REQUEST_ID_UNSUPPORTED", "BLOCKED_MSPROBE_SLICE_MAPPING", "BLOCKED_MSPROBE_UNAVAILABLE", "BLOCKED_MSPROBE_VLLM_ASCEND_GUIDE_UNAVAILABLE", "BLOCKED_PROMPT_LENGTH_EXCEEDS_MODEL_LIMIT", "BLOCKED_REPLACEMENT_REQUIRES_USER_DECISION", "BLOCKED_RUNTIME_PACKAGE_MISSING", "BLOCKED_SCHEDULER_EVIDENCE", "BLOCKED_TP_PLAN_UNCONFIRMED", "BLOCKED_UNSUPPORTED_PROFILE_TEMPERATURE", "FAIL_BLACKLIST", "INVALID_PROFILING_CONFIG", "SKIPPED_TP_RESOURCE_UNAVAILABLE", "PASS_TRIAGE", "REVIEW_REQUIRED", "DUMP_NEGATIVE_OPERATOR_BOUNDARY", "RETRY_TRANSIENT_RESOURCE"]
    },
    "resume_state": {"type": ["string", "null"], "enum": [null, "tp_plan_gate", "environment_admission", "phase1_profiling", "phase1_triage", "phase1_critical_path_review", "phase1_operator_10k", "phase1_replacement", "phase1_reprofile", "phase2_long_output", "phase2_long_input", "phase2_matrix", "phase2_failure_diagnosis", "phase3_math500"]},
    "attempt": {"type": "integer", "minimum": 1},
    "config_summary": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "properties": {
        "tp": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}]},
        "chip": {"enum": ["A2", "A3", "A5", null]},
        "chip_raw": {"type": "string"},
        "chip_source": {"enum": ["SOC_VERSION", "npu-smi"]},
        "installation_capability": {"enum": ["SUPPORTED", "UNSUPPORTED", "UNKNOWN"]},
        "installation_state": {"enum": ["READY", "MISSING", "BROKEN", "NOT_CHECKED"]},
        "visible_devices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": ["integer", "string"]}},
        "temperature": {"type": "number", "minimum": 0},
        "batch_size": {"type": "integer", "minimum": 1},
        "batch_sizes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_tokens": {"type": "integer", "minimum": 1},
        "rounds": {"type": "integer", "minimum": 1},
        "samples_per_round": {"type": "integer", "minimum": 1},
        "enable_prefix_caching": {"type": "boolean"},
        "enable_chunked_prefill": {"type": "boolean"},
        "async_scheduling": {"type": "boolean"},
        "tp_results": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["tp", "status", "reason_code"],
            "properties": {
              "tp": {"type": "integer", "minimum": 1},
              "status": {"enum": ["PASS", "SKIPPED_TP_RESOURCE_UNAVAILABLE"]},
              "reason_code": {"type": ["string", "null"], "enum": [null, "SKIPPED_TP_RESOURCE_UNAVAILABLE"]}
            }
          }
        },
        "scenario_results": {
          "type": "array", "minItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["tp", "batch_size", "input_tokens", "output_tokens", "rounds", "status"],
            "properties": {
              "tp": {"type": "integer", "minimum": 1},
              "batch_size": {"enum": [16, 32]},
              "input_tokens": {"enum": [100, 1024]},
              "output_tokens": {"enum": [512, 2048]},
              "rounds": {"const": 3},
              "status": {"enum": ["PASS", "SKIPPED_TP_RESOURCE_UNAVAILABLE"]}
            }
          }
        },
        "accuracy_pass": {"type": "boolean"},
        "round_results": {
          "type": "array", "minItems": 10, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["round", "successful_samples", "score", "raw_text_sha256"],
            "properties": {
              "round": {"type": "integer", "minimum": 1, "maximum": 10},
              "successful_samples": {"const": 500},
              "score": {"type": "number"},
              "raw_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "type", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
          "type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "handoff": {"enum": ["handoff: ENVIRONMENT_READY", "handoff: ENVIRONMENT_BLOCKED", "handoff: ENVIRONMENT_RESUME", "handoff: PROFILING_READY", "handoff: PROFILING_INVALID", "handoff: PHASE1_BLOCKED", "handoff: PHASE1_RESUME", "handoff: ALLOWLIST_PASS", "handoff: REVIEW_REQUIRED", "handoff: AUXILIARY_PATH_INVALID", "handoff: NON_CRITICAL_PATH_EXCLUDED", "handoff: CRITICAL_PATH_OPERATOR", "handoff: BLACKLIST_REPLACEMENT_REVIEW", "handoff: OPERATOR_10K_PASS", "handoff: OPERATOR_10K_BLOCKED", "handoff: OPERATOR_10K_FAIL", "handoff: REPLACEMENT_READY", "handoff: REPLACEMENT_BLOCKED", "handoff: REPROFILE_READY", "handoff: LONG_OUTPUT_PASS", "handoff: PHASE2_BLOCKED", "handoff: PHASE2_RESUME_LONG_OUTPUT", "handoff: PHASE2_RESUME_LONG_INPUT", "handoff: PHASE2_RESUME_MATRIX", "handoff: PHASE2_RESUME_DIAGNOSIS", "handoff: LONG_INPUT_PASS", "handoff: MATRIX_PASS", "handoff: NUMERICAL_MISMATCH", "handoff: TP_PLAN_CHANGED", "handoff: DIAGNOSIS_FIXED", "handoff: DIAGNOSIS_BLOCKED", "handoff: MATH500_PASS", "handoff: MATH500_FAIL", "handoff: PHASE3_BLOCKED", "handoff: PHASE3_RESUME"]}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "environment"}, "outcome": {"const": "PASS"}}, "required": ["stage", "outcome"]}, "then": {"properties": {"config_summary": {"properties": {"chip": {"enum": ["A2", "A3", "A5"]}}}}}},
    {"if": {"properties": {"stage": {"const": "environment"}}, "required": ["stage"]}, "then": {"properties": {"state": {"enum": ["environment_admission", "blocked_environment"]}}}},
    {"if": {"properties": {"stage": {"const": "phase1"}}, "required": ["stage"]}, "then": {"properties": {"state": {"enum": ["phase1_profiling", "phase1_triage", "phase1_critical_path_review", "phase1_operator_10k", "phase1_replacement", "phase1_reprofile", "blocked_phase1"]}}}},
    {"if": {"properties": {"stage": {"const": "phase2"}}, "required": ["stage"]}, "then": {"properties": {"state": {"enum": ["phase2_long_output", "phase2_long_input", "phase2_matrix", "phase2_failure_diagnosis", "blocked_phase2"]}}}},
    {"if": {"properties": {"stage": {"const": "phase3"}}, "required": ["stage"]}, "then": {"properties": {"state": {"enum": ["phase3_math500", "blocked_phase3"]}}}},
    {"if": {"properties": {"state": {"const": "environment_admission"}}, "required": ["state"]}, "then": {"properties": {"config_summary": {"required": ["tp", "chip", "visible_devices"]}}}},
    {"if": {"properties": {"state": {"pattern": "^phase1_"}}, "required": ["state"]}, "then": {"properties": {"config_summary": {"required": ["tp", "temperature"]}}}},
    {
      "if": {"properties": {"state": {"const": "phase2_long_output"}}, "required": ["state"]},
      "then": {"properties": {"config_summary": {
        "required": ["tp", "batch_size", "input_tokens", "output_tokens"],
        "properties": {"batch_size": {"const": 64}, "input_tokens": {"minimum": 2000, "maximum": 2048}, "output_tokens": {"const": 20480}}
      }}}
    },
    {
      "if": {"properties": {"state": {"const": "phase2_long_input"}}, "required": ["state"]},
      "then": {"properties": {"config_summary": {
        "required": ["tp", "batch_size", "input_tokens", "output_tokens"],
        "properties": {"batch_size": {"const": 64}, "input_tokens": {"const": 20480}, "output_tokens": {"minimum": 2000, "maximum": 2048}}
      }}}
    },
    {
      "if": {"properties": {"state": {"const": "phase2_matrix"}}, "required": ["state"]},
      "then": {"properties": {"config_summary": {
        "required": ["tp", "batch_sizes", "rounds", "tp_results", "scenario_results"],
        "properties": {"batch_sizes": {"const": [16, 32]}, "rounds": {"const": 3}}
      }}}
    },
    {"if": {"properties": {"state": {"const": "phase2_failure_diagnosis"}}, "required": ["state"]}, "then": {"properties": {"config_summary": {"required": ["tp"]}}}},
    {
      "if": {"properties": {"state": {"const": "phase3_math500"}}, "required": ["state"]},
      "then": {"properties": {"config_summary": {
        "required": ["tp", "rounds", "samples_per_round", "temperature", "enable_prefix_caching", "enable_chunked_prefill", "async_scheduling", "accuracy_pass", "round_results"],
        "properties": {"rounds": {"const": 10}, "samples_per_round": {"const": 500}, "temperature": {"const": 0}, "enable_prefix_caching": {"const": false}, "enable_chunked_prefill": {"const": false}, "async_scheduling": {"type": "boolean"}}
      }}}
    },
    {"if": {"properties": {"handoff": {"enum": ["handoff: ENVIRONMENT_READY", "handoff: ENVIRONMENT_RESUME", "handoff: PROFILING_READY", "handoff: PHASE1_RESUME", "handoff: ALLOWLIST_PASS", "handoff: NON_CRITICAL_PATH_EXCLUDED", "handoff: OPERATOR_10K_PASS", "handoff: REPLACEMENT_READY", "handoff: REPROFILE_READY", "handoff: LONG_OUTPUT_PASS", "handoff: PHASE2_RESUME_LONG_OUTPUT", "handoff: PHASE2_RESUME_LONG_INPUT", "handoff: PHASE2_RESUME_MATRIX", "handoff: PHASE2_RESUME_DIAGNOSIS", "handoff: LONG_INPUT_PASS", "handoff: MATRIX_PASS", "handoff: DIAGNOSIS_FIXED", "handoff: MATH500_PASS", "handoff: PHASE3_RESUME"]}}, "required": ["handoff"]}, "then": {"properties": {"outcome": {"const": "PASS"}}}},
    {"if": {"properties": {"handoff": {"enum": ["handoff: ENVIRONMENT_BLOCKED", "handoff: PHASE1_BLOCKED", "handoff: OPERATOR_10K_BLOCKED", "handoff: REPLACEMENT_BLOCKED", "handoff: PHASE2_BLOCKED", "handoff: TP_PLAN_CHANGED", "handoff: DIAGNOSIS_BLOCKED", "handoff: PHASE3_BLOCKED"]}}, "required": ["handoff"]}, "then": {"properties": {"outcome": {"const": "BLOCKED"}}}},
    {"if": {"properties": {"handoff": {"enum": ["handoff: REVIEW_REQUIRED", "handoff: CRITICAL_PATH_OPERATOR"]}}, "required": ["handoff"]}, "then": {"properties": {"outcome": {"const": "REVIEW_REQUIRED"}}}},
    {"if": {"properties": {"handoff": {"enum": ["handoff: PROFILING_INVALID", "handoff: AUXILIARY_PATH_INVALID"]}}, "required": ["handoff"]}, "then": {"properties": {"outcome": {"const": "INVALID"}, "reason_code": {"const": "INVALID_PROFILING_CONFIG"}}}},
    {"if": {"properties": {"handoff": {"const": "handoff: BLACKLIST_REPLACEMENT_REVIEW"}}, "required": ["handoff"]}, "then": {"properties": {"outcome": {"const": "FAIL"}, "reason_code": {"const": "FAIL_BLACKLIST"}}}},
    {"if": {"properties": {"handoff": {"const": "handoff: REPLACEMENT_BLOCKED"}}, "required": ["handoff"]}, "then": {"properties": {"reason_code": {"const": "BLOCKED_REPLACEMENT_REQUIRES_USER_DECISION"}}}},
    {"if": {"properties": {"handoff": {"const": "handoff: TP_PLAN_CHANGED"}}, "required": ["handoff"]}, "then": {"properties": {"reason_code": {"const": "BLOCKED_TP_PLAN_UNCONFIRMED"}}}},
    {"if": {"properties": {"handoff": {"enum": ["handoff: OPERATOR_10K_FAIL", "handoff: NUMERICAL_MISMATCH", "handoff: MATH500_FAIL"]}}, "required": ["handoff"]}, "then": {"properties": {"outcome": {"const": "FAIL"}}}},
    {"if": {"properties": {"outcome": {"const": "BLOCKED"}}, "required": ["outcome"]}, "then": {"properties": {"reason_code": {"type": "string", "pattern": "^BLOCKED_"}, "resume_state": {"type": "string"}}}},
    {"if": {"properties": {"outcome": {"const": "INVALID"}}, "required": ["outcome"]}, "then": {"properties": {"reason_code": {"const": "INVALID_PROFILING_CONFIG"}}}},
    {"if": {"properties": {"outcome": {"const": "SKIPPED"}}, "required": ["outcome"]}, "then": {"properties": {"reason_code": {"const": "SKIPPED_TP_RESOURCE_UNAVAILABLE"}}}},
    {"if": {"properties": {"outcome": {"const": "PASS"}}, "required": ["outcome"]}, "then": {"properties": {"reason_code": {"type": "null"}, "resume_state": {"type": "null"}}}}
  ]
}
