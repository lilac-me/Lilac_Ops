{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindspeed-agent.local/batch-invariance-validation/recovery_attempt.schema.json",
  "title": "Evidence-driven bounded recovery attempt",
  "type": "object",
  "additionalProperties": true,
  "required": ["recovery_key", "round", "stage", "state", "reason_code", "observations", "root_cause_hypotheses", "selected_hypothesis", "planned_actions", "commands", "verification", "reflection", "progress_assessment", "repair_result", "before_evidence_sha256", "after_evidence_sha256"],
  "properties": {
    "recovery_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "round": {"type": "integer", "minimum": 1, "maximum": 5},
    "stage": {"enum": ["environment", "phase1", "phase2", "phase3"]},
    "state": {"type": "string", "minLength": 1},
    "reason_code": {"type": "string", "minLength": 1},
    "observations": {"type": "array", "minItems": 1},
    "root_cause_hypotheses": {"type": "array", "minItems": 1},
    "selected_hypothesis": {"type": "string", "minLength": 1},
    "planned_actions": {"type": "array", "minItems": 1},
    "commands": {"type": "array", "minItems": 1},
    "verification": {"type": "array", "minItems": 1},
    "reflection": {"type": "string", "minLength": 1},
    "progress_assessment": {"enum": ["PROGRESSED", "NO_PROGRESS"]},
    "repair_result": {"enum": ["PASS", "BLOCKED"]},
    "before_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "after_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
