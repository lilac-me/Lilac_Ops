{
  "$id": "parallel_recipe.json",
  "title": "VeOmni 并行策略配置",
  "type": "object",
  "required": ["model", "world_size", "device_mesh", "fsdp2", "dtype", "batch"],
  "properties": {
    "model": { "type": "string" },
    "world_size": { "type": "integer", "minimum": 1 },
    "device_mesh": {
      "type": "object",
      "required": ["dp"],
      "properties": {
        "dp": { "type": "integer", "minimum": 1 },
        "sp": { "type": "integer", "minimum": 1 },
        "ep": { "type": "integer", "minimum": 1 },
        "pp": { "type": "integer", "minimum": 1 }
      }
    },
    "fsdp2": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "sharding_strategy": { "type": "string" },
        "recomputation": { "type": "string", "enum": ["none", "full", "selective"] }
      }
    },
    "dtype": { "type": "string", "enum": ["fp16", "bf16", "fp32"] },
    "batch": {
      "type": "object",
      "required": ["micro_batch", "global_batch"],
      "properties": {
        "micro_batch": { "type": "integer", "minimum": 1 },
        "global_batch": { "type": "integer", "minimum": 1 },
        "gradient_accumulation": { "type": "integer", "minimum": 1 }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "memory_gb_estimate", "communication_estimate"],
        "properties": {
          "name": { "type": "string" },
          "memory_gb_estimate": { "type": "number" },
          "communication_estimate": { "type": "string" },
          "selected": { "type": "boolean" }
        }
      }
    },
    "consistency_check": {
      "type": "object",
      "properties": {
        "executed": { "type": "boolean" },
        "single_card_loss": { "type": ["number", "null"] },
        "distributed_loss": { "type": ["number", "null"] },
        "consistent": { "type": "boolean" }
      }
    }
  }
}