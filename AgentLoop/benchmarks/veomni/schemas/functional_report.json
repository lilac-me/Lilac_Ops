{
  "$id": "functional_report.json",
  "title": "VeOmni 功能验证报告",
  "type": "object",
  "required": ["model", "source_revision", "cases", "conclusion"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "stage", "executed", "status", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "stage": {
            "type": "string",
            "enum": ["build", "forward", "backward", "checkpoint"]
          },
          "executed": { "type": "boolean" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "evidence": { "type": "string", "minLength": 1 },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "conclusion": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] }
  }
}
