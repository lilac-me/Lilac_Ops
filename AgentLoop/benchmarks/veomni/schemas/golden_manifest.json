{
  "$id": "golden_manifest.json",
  "title": "VeOmni Golden 固化清单",
  "type": "object",
  "required": ["model", "code_revision", "weights", "inputs", "seeds", "dtype", "generation"],
  "properties": {
    "model": { "type": "string" },
    "code_revision": { "type": "string", "minLength": 1 },
    "weights": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "seq_len": { "type": "integer", "minimum": 1 },
        "batch_size": { "type": "integer", "minimum": 1 }
      }
    },
    "seeds": {
      "type": "object",
      "required": ["torch", "python", "numpy"],
      "properties": {
        "torch": { "type": "integer" },
        "python": { "type": "integer" },
        "numpy": { "type": "integer" }
      }
    },
    "dtype": { "type": "string", "enum": ["fp16", "bf16", "fp32"] },
    "training_config": { "type": "string" },
    "generation": {
      "type": "object",
      "required": ["platform", "artifacts"],
      "properties": {
        "platform": { "type": "string", "enum": ["gpu", "npu_single", "npu_multi"] },
        "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "command": { "type": "string" }
      }
    }
  }
}