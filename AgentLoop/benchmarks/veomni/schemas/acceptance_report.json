{
  "$id": "acceptance_report.json",
  "title": "VeOmni 最终验收报告",
  "type": "object",
  "required": ["model", "stages", "regression", "reproduce_commands", "conclusion"],
  "properties": {
    "model": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "status", "artifacts"],
        "properties": {
          "stage": {
            "type": "string",
            "enum": ["environment", "model-analysis", "adaptation", "functional-validation",
                     "parallel-recipe", "precision-alignment", "mfu-calculation",
                     "performance-tuning", "delivery", "acceptance"]
          },
          "status": { "type": "string", "enum": ["PASSED", "FAILED", "BLOCKED", "NEEDS_HUMAN"] },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "regression": {
      "type": "object",
      "required": ["passed", "scope"],
      "properties": {
        "passed": { "type": "boolean" },
        "scope": { "type": "string" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "reproduce_commands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "conclusion": { "type": "string", "minLength": 1 }
  }
}
