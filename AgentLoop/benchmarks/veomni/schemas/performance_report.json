{
  "$id": "performance_report.json",
  "title": "VeOmni 性能调优报告",
  "type": "object",
  "required": ["model", "baseline", "bottlenecks", "optimizations", "conclusion"],
  "properties": {
    "model": { "type": "string" },
    "baseline": {
      "type": "object",
      "required": ["step_time_ms", "throughput_tokens_per_s", "memory_gb"],
      "properties": {
        "step_time_ms": { "type": "number", "exclusiveMinimum": 0 },
        "throughput_tokens_per_s": { "type": "number", "exclusiveMinimum": 0 },
        "memory_gb": { "type": "number", "minimum": 0 },
        "noise_band": { "type": "number", "minimum": 0 },
        "hardware": { "type": "string" },
        "parallel_config": { "type": "string" },
        "source_revision": { "type": "string" }
      }
    },
    "profiling": {
      "type": "object",
      "properties": {
        "tool": { "type": "string" },
        "steps_collected": { "type": "integer", "minimum": 1 },
        "warmup_excluded": { "type": "boolean" }
      }
    },
    "bottlenecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "evidence"],
        "properties": {
          "type": { "type": "string", "enum": ["compute", "communication", "host", "memory", "dataloader"] },
          "evidence": { "type": "string" },
          "share": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "optimizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variable", "before", "after", "exceeds_noise"],
        "properties": {
          "variable": { "type": "string" },
          "before": { "type": "number" },
          "after": { "type": "number" },
          "gain_percent": { "type": "number" },
          "exceeds_noise": { "type": "boolean" },
          "precision_rerun": { "type": "string", "enum": ["PASS", "FAIL", "PENDING"] }
        }
      }
    },
    "conclusion": { "type": "string", "minLength": 1 }
  }
}