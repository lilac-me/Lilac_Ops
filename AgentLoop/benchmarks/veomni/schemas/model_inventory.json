{
  "$id": "model_inventory.json",
  "title": "VeOmni 模型接入清单",
  "type": "object",
  "required": ["model", "model_type", "structure", "assets", "integration", "parallel_needs", "reference_model", "workload", "risks"],
  "properties": {
    "model": { "type": "string" },
    "model_type": { "type": "string", "enum": ["dense", "moe", "vlm", "omni", "dit", "rl"] },
    "structure": {
      "type": "object",
      "required": ["layers", "hidden_size", "params_total"],
      "properties": {
        "layers": { "type": "integer", "minimum": 1 },
        "hidden_size": { "type": "integer", "minimum": 1 },
        "params_total": { "type": "string" },
        "params_active": { "type": ["string", "null"] },
        "experts": { "type": ["integer", "null"] },
        "top_k": { "type": ["integer", "null"] }
      }
    },
    "assets": {
      "type": "object",
      "required": ["config", "modeling", "tokenizer", "weight_format"],
      "properties": {
        "config": { "type": "string" },
        "modeling": { "type": "array", "items": { "type": "string" } },
        "processor": { "type": ["string", "null"] },
        "tokenizer": { "type": "string" },
        "weight_format": { "type": "string" }
      }
    },
    "integration": {
      "type": "object",
      "required": ["patchgen_configs", "registry_points", "trainer", "data_fields"],
      "properties": {
        "patchgen_configs": { "type": "array", "items": { "type": "string" } },
        "registry_points": { "type": "array", "items": { "type": "string" } },
        "trainer": { "type": "string", "enum": ["text", "vlm", "dit", "omni", "rl"] },
        "data_fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "operator_gaps": { "type": "array", "items": { "type": "string" } },
    "parallel_needs": {
      "type": "object",
      "required": ["fsdp2"],
      "properties": {
        "fsdp2": { "type": "boolean" },
        "ulysses_sp": { "type": "boolean" },
        "ep": { "type": "boolean" }
      }
    },
    "reference_model": { "type": "string" },
    "workload": { "type": "string", "enum": ["small", "medium", "large"] },
    "risks": { "type": "array", "items": { "type": "string" } }
  }
}