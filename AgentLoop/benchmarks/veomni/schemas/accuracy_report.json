{
  "$id": "accuracy_report.json",
  "title": "VeOmni 精度对齐报告",
  "type": "object",
  "required": ["model", "pairs", "conclusion"],
  "properties": {
    "model": { "type": "string" },
    "golden_manifest": { "type": "string" },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["baseline", "target", "threshold", "conclusion"],
        "properties": {
          "baseline": { "type": "string", "enum": ["gpu", "npu_single", "npu_multi"] },
          "target": { "type": "string", "enum": ["gpu", "npu_single", "npu_multi"] },
          "threshold": {
            "type": "object",
            "required": ["metric", "value", "rationale"],
            "properties": {
              "metric": { "type": "string" },
              "value": { "type": "number" },
              "rationale": { "type": "string" }
            }
          },
          "first_divergence": {
            "type": ["object", "null"],
            "properties": {
              "node": { "type": "string" },
              "layer": { "type": "integer" },
              "diff": {
                "type": "object",
                "properties": {
                  "max_abs": { "type": "number" },
                  "rel": { "type": "number" },
                  "cosine": { "type": ["number", "null"] }
                }
              }
            }
          },
          "nan_inf": { "type": "boolean" },
          "conclusion": { "type": "string", "enum": ["PASS", "FAIL"] }
        }
      }
    },
    "parallel_impact": {
      "type": "object",
      "properties": {
        "fsdp2": { "type": "string", "enum": ["PASS", "FAIL", "N/A"] },
        "sp": { "type": "string", "enum": ["PASS", "FAIL", "N/A"] },
        "ep": { "type": "string", "enum": ["PASS", "FAIL", "N/A"] }
      }
    },
    "regression": {
      "type": "object",
      "required": ["executed"],
      "properties": {
        "executed": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "scope": { "type": "string" }
      }
    },
    "conclusion": { "type": "string", "minLength": 1 }
  }
}