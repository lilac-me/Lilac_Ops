{
  "$id": "patch_manifest.json",
  "title": "VeOmni Patchgen 产物清单",
  "type": "object",
  "required": ["model", "source_revision", "patch_configs", "generated_files", "registry_items", "tests"],
  "properties": {
    "model": { "type": "string" },
    "source_revision": { "type": "string", "minLength": 1 },
    "patch_configs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "target"],
        "properties": {
          "path": { "type": "string" },
          "target": { "type": "string", "enum": ["gpu", "npu"] }
        }
      }
    },
    "generated_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "registry_items": { "type": "array", "items": { "type": "string" } },
    "weight_conversion": {
      "type": ["object", "null"],
      "properties": {
        "script": { "type": "string" },
        "mapping_table": { "type": "string" }
      }
    },
    "training_configs": { "type": "array", "items": { "type": "string" } },
    "tests": {
      "type": "object",
      "required": ["load", "forward", "train"],
      "properties": {
        "load": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "forward": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "train": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "commands": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}